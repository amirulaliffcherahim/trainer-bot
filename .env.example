# === Telegram ===
# Bot token from @BotFather (/newbot). If this was EVER shared (chat, pastebin,
# screenshots), regenerate: BotFather -> /revoke -> /token. Keep it out of git.
TELEGRAM_BOT_TOKEN=

# === DeepSeek (primary LLM) ===
# API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
# OpenAI-compatible endpoint. Change only if swapping provider (Qwen, GLM, Ollama...).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === Vision (OPTIONAL) ===
# DeepSeek API is text-only. Screenshots use local OCR by default (free).
# Set this ONLY if you upgrade to the vision-LLM route (Gemini Flash):
# https://aistudio.google.com/apikey
VISION_API_KEY=

# === Access control ===
# Your Telegram user ID(s), comma-separated. ONLY these users may use the bot.
# Get yours: message @userinfobot
ALLOWED_USER_IDS=

# === Models ===
PRIMARY_MODEL=deepseek-v4-flash
FALLBACK_MODEL=deepseek-v4-pro

# === Runtime ===
LOG_LEVEL=INFO
DB_PATH=trainer_data.db
# Daily run-reminder time (HH:MM) — fires when today has a scheduled session
RUN_REMIND_TIME=17:30

# === Strava direct sync (OPTIONAL) ===
# One-time setup: python strava_auth.py <client_id> <client_secret>
# (app: https://www.strava.com/settings/api). Then /sync imports your runs
# with authoritative numbers — no screenshots needed.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
