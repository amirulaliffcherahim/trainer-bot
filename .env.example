# Strava API application credentials (create at https://www.strava.com/settings/api)
# NEVER commit the real .env — this is the template.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public base URL of this app — used as the OAuth redirect_uri origin.
# Strava's Authorization Callback Domain must match this host.
# localhost / 127.0.0.1 are whitelisted for local dev.
APP_BASE_URL=http://localhost:5173

# SQLite path (relative to where the server runs)
DB_PATH=trainer.db
